# Generate .env.docker with: python3 scripts/docker_setup.py
# This file is a template, never put real credentials in it.
COMPOSE_PROJECT_NAME=sewer-agent
SEWER_IMAGE_TAG=local
SEWER_BIND_ADDRESS=127.0.0.1
SEWER_HTTP_PORT=8000
SEWER_MODELS_DIR=./models

# Generated independently by docker_setup.py; keep these when reusing database volumes.
POSTGRES_ADMIN_PASSWORD=GENERATE
SEWER_APP_DB_PASSWORD=GENERATE
SEWER_TEMPORAL_DB_PASSWORD=GENERATE

# Qwen example: change endpoint/model to the provider/region enabled for your account.
SEWER_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SEWER_LLM_MODEL=qwen3.8-max
SEWER_VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SEWER_VLM_MODEL=qwen3.8-max
DASHSCOPE_API_KEY=
# For another provider, set these two keys explicitly instead of DASHSCOPE_API_KEY.
SEWER_LLM_API_KEY=
SEWER_VLM_API_KEY=
SEWER_API_ENABLE_THINKING=false
SEWER_API_MAX_OUTPUT_TOKENS=4096
SEWER_API_TIMEOUT_SECONDS=60
SEWER_MAX_UPLOAD_BYTES=1073741824
