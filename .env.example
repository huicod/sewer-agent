# API configuration reference; never commit .env or paste keys in chat.
# runtime.py init generates the database DSN in a managed block in .env.
# Add API fields to the existing .env instead of overwriting that managed block.
SEWER_DATABASE_DSN=postgresql://sewer_agent@127.0.0.1:5432/sewer_agent
SEWER_TEMPORAL_ADDRESS=127.0.0.1:7233
SEWER_TEMPORAL_NAMESPACE=default
SEWER_ASSET_ROOT=var/assets
SEWER_DETECTOR_DEVICE=0

# Configure each API independently; no default provider or paid calls.
# SEWER_LLM_BASE_URL=https://your-provider.example/v1
# SEWER_LLM_MODEL=your-model
# SEWER_LLM_API_KEY=configure-locally
# SEWER_VLM_BASE_URL=https://your-provider.example/v1
# SEWER_VLM_MODEL=your-vision-model
# SEWER_VLM_API_KEY=configure-locally
